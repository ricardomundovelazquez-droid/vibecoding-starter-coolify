# =============================================================
# .env.example — Copia este archivo como .env.local
# Llena los valores reales. Nunca subas .env.local a GitHub.
# Usa @setup en Cursor si tienes dudas sobre alguna variable.
# =============================================================


# -------------------------------------------------------------
# BASE DE DATOS (obligatorio)
# Obtén esto de Coolify → PostgreSQL → Connection URL
# Si la contraseña tiene $ usa %24 en su lugar
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname"


# -------------------------------------------------------------
# AUTENTICACIÓN (obligatorio)
# AUTH_SECRET: ejecuta `openssl rand -base64 32` en la terminal
# AUTH_URL: http://localhost:3000 en local, tu dominio en prod
# -------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"


# -------------------------------------------------------------
# GOOGLE OAUTH (opcional — activar en INSTRUCTIONS.md)
# Obtén las credenciales en: console.cloud.google.com
# APIs & Services → Credentials → OAuth 2.0 Client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# -------------------------------------------------------------
# STORAGE — MinIO (opcional — activar en INSTRUCTIONS.md)
# Obtén estos datos del panel de MinIO en Coolify (puerto 9001)
# -------------------------------------------------------------
MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET_NAME=""


# -------------------------------------------------------------
# EMAIL — Resend (opcional — activar en INSTRUCTIONS.md)
# Obtén tu API key en: resend.com → Dashboard → API Keys
# -------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@tudominio.com"


# -------------------------------------------------------------
# PAGOS — Stripe (opcional — activar en INSTRUCTIONS.md)
# Obtén tus claves en: dashboard.stripe.com → Developers → API Keys
# Usa las claves de TEST hasta que estés en producción
# -------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""


# -------------------------------------------------------------
# AI / LLM (opcional — activar en INSTRUCTIONS.md)
# Groq es gratuito para empezar: console.groq.com
# OpenRouter como alternativa: openrouter.ai
# -------------------------------------------------------------
GROQ_API_KEY=""
OPENROUTER_API_KEY=""


# -------------------------------------------------------------
# APP (configuración general)
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Mi Proyecto"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
